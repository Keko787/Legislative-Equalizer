# Copy this file to `.env` and fill in your values.
# `.env` is gitignored — never commit real keys.

# --- LLM ---
OPENAI_API_KEY=

# --- Web research sub-agent (optional) ---

# If set, the sub-agent uses Tavily as its search backend.
# If empty, it falls back to a keyless DuckDuckGo HTML scrape.
TAVILY_API_KEY=

# Master switch for the sub-agent. "true" / "false". Default: true.
WEB_RESEARCH_ENABLED=true

# Per-document wall-clock budget for all web research, in seconds.
WEB_RESEARCH_PER_DOC_BUDGET_SEC=60

# Per-clause hard timeout, in seconds.
WEB_RESEARCH_PER_CLAUSE_TIMEOUT_SEC=12

# Disk cache TTL for fetched pages, in days.
WEB_RESEARCH_CACHE_TTL_DAYS=14
